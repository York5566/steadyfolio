{
  "name": "steadyfolio-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && tsx scripts/build-pages.ts && tsx scripts/notices.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "check": "npm run test && npm run build && npm run test:site",
    "test:site": "tsx scripts/check-site.ts",
    "dev:api": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply steadyfolio --local",
    "db:remote": "wrangler d1 migrations apply steadyfolio --remote",
    "deploy": "tsx scripts/preflight.ts && wrangler deploy --config wrangler.deploy.json",
    "data:import": "tsx scripts/import-market.ts",
    "test:api": "tsx scripts/api-smoke.ts",
    "package:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "@types/node": "26.6.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
